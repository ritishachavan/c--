{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "compile and run",
            "command": "g++",
            "args": [
                "-std=c++17",
                "${file}",
                "-o",
                "${fileBasenameNoExtension}.exe",
                "&&",
                "${fileBasenameNoExtension}.exe",
                "<",
                "input.txt",
                ">",
                "output.txt"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}